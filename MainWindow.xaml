<Window x:Class="TodoFloat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TodoFloat"
        Title="Todo Float" Width="610" Height="720" MinWidth="450" MinHeight="460"
        WindowStartupLocation="CenterScreen" Topmost="True" Background="Transparent"
        AllowsTransparency="True" WindowStyle="None">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="9,5"/>
      <Setter Property="Background" Value="#2F78C4"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="#777"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,4"/></Style>
  </Window.Resources>
  <Border x:Name="Shell" CornerRadius="14" Padding="18" Background="#F7F9FC" BorderBrush="#4B78A9" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,12" Background="Transparent" PreviewMouseLeftButtonDown="HeaderDrag">
        <StackPanel DockPanel.Dock="Left"><TextBlock Text="TODO FLOAT" FontWeight="Bold" FontSize="18"/><TextBlock Text="Always on top • Your focused task space" Opacity=".65" FontSize="11"/></StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="⚙ Settings" Click="Settings_Click"/><Button Content="—" Click="Minimize_Click"/><Button Content="×" Background="#B64A4A" Click="Close_Click"/></StackPanel>
      </DockPanel>

      <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="125"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="NewTaskBox" VerticalContentAlignment="Center" ToolTip="What needs doing?" KeyDown="NewTaskBox_KeyDown"/>
        <ComboBox x:Name="NewCategory" Grid.Column="1" Margin="6,0,0,0" SelectedIndex="0"><ComboBoxItem>General</ComboBoxItem><ComboBoxItem>Work</ComboBoxItem><ComboBoxItem>Personal</ComboBoxItem><ComboBoxItem>Errands</ComboBoxItem></ComboBox>
        <DatePicker x:Name="NewDueDate" Grid.Column="2" Margin="6,0,0,0" SelectedDateFormat="Short"/>
        <Button Grid.Column="3" Content="Add" Click="Add_Click"/>
      </Grid>

      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
        <Border Background="#12000000" CornerRadius="9" Padding="6" Margin="0,0,12,0">
          <ListView x:Name="TodoList" BorderThickness="0" Background="Transparent" ItemsSource="{Binding Todos}">
            <ListView.ItemTemplate><DataTemplate DataType="{x:Type local:TodoItem}">
              <Border Padding="8" Margin="2" Background="#18FFFFFF" CornerRadius="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsComplete}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsComplete}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Opacity" Value=".5"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock FontSize="11" Opacity=".65"><Run Text="{Binding Category}"/><Run Text="  •  "/><Run Text="{Binding Status}"/><Run Text="  "/><Run Text="{Binding DueDate, StringFormat=MMM d}"/></TextBlock></StackPanel>
                <ComboBox Grid.Column="2" SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" VerticalAlignment="Center"><ComboBoxItem>Not started</ComboBoxItem><ComboBoxItem>In progress</ComboBoxItem><ComboBoxItem>Waiting</ComboBoxItem><ComboBoxItem>Completed</ComboBoxItem></ComboBox>
                <Button Grid.Column="3" Content="×" Background="Transparent" Foreground="#B64A4A" Padding="2" Tag="{Binding}" Click="Delete_Click"/>
              </Grid></Border>
            </DataTemplate></ListView.ItemTemplate>
          </ListView>
        </Border>
        <Border Grid.Column="1" Background="#12000000" CornerRadius="9" Padding="7"><StackPanel><TextBlock Text="MONTH AT A GLANCE" FontWeight="Bold" FontSize="11" Margin="3"/><Calendar x:Name="MonthCalendar" SelectedDatesChanged="Calendar_SelectedDatesChanged"/></StackPanel></Border>
      </Grid>

      <DockPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="SummaryText" Text="0 tasks" VerticalAlignment="Center" Opacity=".65"/><Button DockPanel.Dock="Right" Content="Clear completed" Background="#686E78" Click="ClearCompleted_Click"/></DockPanel>
    </Grid>
  </Border>
</Window>
