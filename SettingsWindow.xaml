<Window x:Class="TodoFloat.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Todo Float settings" Width="360" Height="280" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <CheckBox x:Name="DarkTheme" Content="Dark theme" Margin="0,0,0,12"/>
  <StackPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="Window transparency"/><Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1" Value="1" TickFrequency=".05" IsSnapToTickEnabled="True"/><TextBlock x:Name="OpacityLabel" Opacity=".65"/></StackPanel>
  <StackPanel Grid.Row="2"><TextBlock Text="Text size"/><Slider x:Name="TextSizeSlider" Minimum="11" Maximum="22" Value="14" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock x:Name="TextSizeLabel" Opacity=".65"/></StackPanel>
  <DockPanel Grid.Row="3" VerticalAlignment="Bottom"><CheckBox x:Name="AlwaysTop" Content="Keep above other windows" IsChecked="True" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Apply" Padding="18,6" Click="Apply_Click"/></DockPanel>
 </Grid>
</Window>
